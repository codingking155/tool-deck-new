# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# ╔════════════════════════════════════════════════════════════════════════╗
# ║  ANYTHING PREFIXED VITE_ IS COMPILED INTO THE PUBLIC BUNDLE.           ║
# ║  Never put a secret behind a VITE_ prefix. Assume users can read it.   ║
# ╚════════════════════════════════════════════════════════════════════════╝

# ─── Frontend (public) ───────────────────────────────────────────────────────
# Canonical origin for <link rel=canonical>, og:url and the sitemap. Set this
# per-environment so preview deploys stop declaring production as canonical.
VITE_SITE_ORIGIN=********
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# YouTube Downloader backend (youtube-downloader/backend on Render), e.g. https://tooldeck-ytdl.onrender.com
# If you use a custom domain, also add it to connect-src in vercel.json.
VITE_DOWNLOADER_API_URL=

# ─── Edge Functions (server-only secrets) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses Row Level Security entirely. Treat as the root database password.
SUPABASE_SERVICE_ROLE_KEY=

# openssl rand -base64 48
ALERT_TOKEN_SECRET=
# openssl rand -base64 32
CRON_SECRET=

APP_BASE_URL=********
FUNCTIONS_BASE=

# Comma-separated CORS allowlist. Leave unset in production to fail closed.
# "*" is accepted but refused when NODE_ENV/DENO_ENV looks like production.
ALLOWED_ORIGIN=********

# Number of proxy hops you trust in X-Forwarded-For. Supabase Edge = 1.
# The client-supplied left-hand entries are ignored; see _shared/ratelimit.ts.
TRUSTED_PROXY_HOPS=1

# ─── Providers (default ******** — nothing is actually sent) ─────────────────────
EMAIL_PROVIDER=********
RESEND_API_KEY=
RESEND_FROM=********

WHATSAPP_PROVIDER=********
META_WA_TOKEN=
META_WA_PHONE_ID=

# ─── Limits ──────────────────────────────────────────────────────────────────
ALERT_RATE_LIMIT_MAX=20
ALERT_RATE_LIMIT_WINDOW_MS=60000
# Max concurrent unconfirmed alerts per contact, and per contact overall.
ALERT_MAX_PENDING_PER_CONTACT=3
ALERT_MAX_ACTIVE_PER_CONTACT=25
# Confirmation links expire after this many hours.
ALERT_CONFIRM_TTL_HOURS=48
# Guest alert rows are purged this many days after they end.
ALERT_RETENTION_DAYS=90
# Per-IP daily egress budget for the speed test (bytes). 1 GiB default.
SPEEDTEST_DAILY_BYTE_BUDGET=1073741824

# ─── Price Tracker data providers (server-only) ──────────────────────────────
# Configure at least one, or lookups fail honestly with "not configured".
# Amazon Product Advertising API 5.0 (requires an approved Associates account).
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
# Partner tag for amazon.in, or JSON per marketplace: {"amazon.in":"x-21","amazon.com":"x-20"}
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_PARTNER_TAGS=
# v2 (OffersV2, default) or v1 (legacy Offers resources)
AMAZON_PAAPI_OFFERS_VERSION=v2
# Optional licensed price history (imported once per product, original timestamps kept).
KEEPA_API_KEY=
# Marketplaces the tracker accepts.
PRICE_TRACKER_MARKETPLACES=amazon.in
PRICE_CHECK_INTERVAL_MINUTES=360
PRICE_ALERT_CHECK_INTERVAL_MINUTES=60
PRICE_CHECK_RETRY_MINUTES=30
PRICE_MIN_REFRESH_MINUTES=10
PRICE_LOOKUP_RATE_LIMIT_MAX=30

# Retailer hosts a tracked product URL may point at. Anything else is rejected.
PRODUCT_URL_ALLOWED_HOSTS=********
