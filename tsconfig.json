{
  // Type-check of the JS sources (`npm run typecheck`, a Vercel deployment check). Non-strict on purpose:
  // it catches wrong imports, undefined names and bad calls without demanding annotations.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "shared", "types"]
}
