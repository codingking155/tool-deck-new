# Public URL of the site (no trailing slash). Used for canonical URLs, OG images, the sitemap
# and the "Add prefix" instructions. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://storescout.example

# Optional: the API subdomain, e.g. api.storescout.example. When set, the docs show
# https://<this host>/check; otherwise they show <site>/api/check.
NEXT_PUBLIC_API_HOST=

# GitHub repository (owner/name) for the header "Star" button and the live star count.
GITHUB_REPO=your-org/your-repo

# Upstash Redis — shared cache and rate limits across serverless instances.
# Leave empty to fall back to per-instance in-memory LRU cache and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
