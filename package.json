{
  "name": "tooldeck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ToolDeck BLR — fifteen fast, private utilities",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "e2e": "node tests/e2e/local.mjs",
    "test:q": "node --test --test-reporter=dot tests/*.test.mjs",
    "check": "npm run -s test:q && vite build --logLevel error && node scripts/check-bundle.mjs",
    "preview:csp": "vite build --config vite.csp-preview.config.js --logLevel error && vite preview --config vite.csp-preview.config.js --port 4173"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/besley": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@jspawn/qpdf-wasm": "^0.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^8.5.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sortablejs": "^1.15.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "jszip": "^3.10.2",
    "playwright": "^1.63.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.2"
  },
  "allowScripts": {
    "esbuild": true,
    "tesseract.js": false
  }
}
