{
  "name": "tooldeck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ToolDeck BLR — six fast, private browser utilities",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:q": "node --test --test-reporter=dot tests/*.test.mjs",
    "check": "npm run -s test:q && vite build --logLevel error"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.2"
  }
}
